# Underlay Leaf Template
#
# Variables
# - bgp_asn: The BGP AS number
# - vtep_ip: The IP address of the VTEP interface

interfaces:
  loopbacks:
    - id: 1
      interface_groups: [loopback]
      ipv4:
        address: ${vtep_ip}
        address_mask: 255.255.255.255
  ethernets:
%{ for index, device in [for d in GLOBAL.devices : d if contains(d.device_groups, "SPINES")] }
    - type: GigabitEthernet
      id: 1/0/${index + 1}
      interface_groups: [fabric]
%{ endfor }
  nves:
    - id: 1
      host_reachability_protocol_bgp: true
      source_interface_type: Loopback
      source_interface_id: 1
routing:
  bgp:
    as_number: ${bgp_asn}
    neighbors:
%{ for index, device in [for d in GLOBAL.devices : d if contains(d.device_groups, "SPINES")] }
      - ip: ${device.variables.lo0_ip}
        remote_as: ${bgp_asn}
        update_source_interface_type: Loopback
        update_source_interface_id: 0
%{ endfor }
    address_family:
      l2vpn_evpn:
        neighbors:
%{ for index, device in [for d in GLOBAL.devices : d if contains(d.device_groups, "SPINES")] }
          - ip: ${device.variables.lo0_ip}
            activate: true
            send_community: both
%{ endfor }
evpn:
  replication_type: static
  router_id_interface_type: Loopback
  router_id_interface_id: 1
  default_gateway_advertise: true
  logging_peer_state: true
  route_target_auto_vni: true